# ===== Supabase (Project Settings -> API) =====
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only. NEVER in apps/web or NEXT_PUBLIC_*

# ===== Web (apps/web/.env.local) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== API =====
PORT=4000
CORS_ORIGINS=http://localhost:3000   # comma-separated; add the Vercel URL in prod
PUBLISH_MODE=mock                    # mock | live
MOCK_PUBLISH_FAIL_RATE=0             # 0..1, demo retries/failures
TOKEN_ENCRYPTION_KEY=                # openssl rand -base64 32 (OAuth tokens at rest)

# ===== AI providers (everything defaults to mock = works with no keys) =====
AI_TEXT_PROVIDER=mock                # mock | openai (any OpenAI-compatible endpoint) | featherless (uses FEATHERLESS_API_KEY below)
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324  # text model when AI_TEXT_PROVIDER=featherless
OPENAI_API_KEY=                      # OpenAI key, or your Gemini key when using the Gemini endpoint below
OPENAI_BASE_URL=                     # Gemini (free tier): https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gpt-4o-mini             # Gemini: gemini-2.5-flash

AI_IMAGE_PROVIDER=mock               # mock | gemini | openai
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  # free tier. For best likeness use the Pro image model ("Nano Banana Pro", paid) — copy its exact id from AI Studio
MAX_REFERENCE_IMAGES=4               # selfies sent per generation (Pro models accept many more)
OPENAI_IMAGE_MODEL=gpt-image-1

AI_VIDEO_PROVIDER=mock               # mock | higgsfield (Kling 3.0 animates scene stills; needs a real AI_IMAGE_PROVIDER, mock stills are SVG)
# Higgsfield: put the real value in .env.local (gitignored), never here. Format: key-id:key-secret
HF_CREDENTIALS=

AI_VOICE_PROVIDER=mock               # mock | elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                 # pick one in the ElevenLabs voice library
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ===== Research (archetype playbooks) =====
RESEARCH_SOURCE=mock                 # mock | apify   (modular: add more sources in packages/research/src/sources)
RESEARCH_WATCHER=mock                # mock | vision | gemini  (vision = frames+transcript to any OpenAI-compatible vision model, e.g. Featherless; gemini = whole video via GEMINI_API_KEY)
RESEARCH_CONCURRENCY=2               # influencers researched in parallel (Featherless/Apify concurrency limits)
# --- vision watcher (RESEARCH_WATCHER=vision). Downloaded videos are kept in the private Supabase bucket "research-videos".
FEATHERLESS_API_KEY=                 # https://featherless.ai  (used when VIDEO_MODEL_API_KEY is empty)
VIDEO_MODEL_API_KEY=                 # optional: key for a different OpenAI-compatible provider
VIDEO_MODEL_BASE_URL=https://api.featherless.ai/v1
VIDEO_MODEL_NAME=google/gemma-3-27b-it  # MUST be a vision (image-input) model; filter featherless.ai/models by vision
VIDEO_FRAMES=8                       # evenly spaced frames sent per video
VIDEO_MODEL_CONCURRENCY=1            # model calls at once. Featherless bills "units": a 4-unit plan + a 4-unit model (e.g. Kimi-K3) = 1. 429s are retried with backoff
APIFY_MAX_CONCURRENT=3               # Apify actor runs at once (free plan allows 5); 402 concurrent-limit errors are retried
# --- speech-to-text for the vision watcher (models can't hear audio)
TRANSCRIBE_PROVIDER=none             # none | mock | openai | groq
TRANSCRIBE_API_KEY=                  # falls back to OPENAI_API_KEY / GROQ_API_KEY
TRANSCRIBE_BASE_URL=                 # optional; groq defaults to https://api.groq.com/openai/v1
TRANSCRIBE_MODEL=                    # default whisper-1 (openai) / whisper-large-v3-turbo (groq)
# --- downloads: yt-dlp is the fallback for YouTube/TikTok/expired links. Install once: pnpm --filter @pseudo/research setup:ytdlp
YTDLP_PATH=                          # optional override; default <repo>/.cache/bin/yt-dlp
FFMPEG_PATH=                         # optional override; default bundled ffmpeg-static
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper        # verify actor ids on apify.com/store
APIFY_INSTAGRAM_ACTOR=apify~instagram-reel-scraper
APIFY_YOUTUBE_ACTOR=streamers~youtube-shorts-scraper  # input: channels + maxResultsShorts
APIFY_X_ACTOR=apidojo~tweet-scraper
GEMINI_VIDEO_MODEL=gemini-2.5-flash
RESEARCH_VIDEOS_PER_INFLUENCER=3
PLAYBOOK_MAX_AGE_HOURS=24

# ===== Demo seed =====
DEMO_EMAIL=demo@pseudo.app
DEMO_PASSWORD=pseudo-demo-2026
