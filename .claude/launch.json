{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web"
      ],
      "port": 3000
    },
    {
      "name": "web-a2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pseudo/web",
        "exec",
        "next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}